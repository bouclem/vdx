// VDX v0.1.5 regression tests — expected output noted per line
class Counter {
    let n = 0;
    fn bump() {
        this.n = this.n + 1;   // HIGH-1: field write must survive method exit
        n = n + 1;             // bare name and this.n are the same storage
        return this.n;
    }
}
let c = new Counter();
print(c.bump());          // 2
print(c.n);               // 2

// HIGH-2: int[] type annotation parses
let nums: int[] = [1, 2, 3];
print(len(nums));         // 3

// HIGH-3: user variable named 'math' shadows the module
class FakeMath { let pi = 3; }
let math = new FakeMath();
print(math.pi);           // 3 (not 3.14159)
let fs = {"x": 1};
print(fs["x"]);           // 1

// MEDIUM: plain function called from a method must NOT see 'this'
class Caller {
    fn run() { return plain(); }
}
fn plain() { return 7; }
let cl = new Caller();
print(cl.run());          // 7

// MEDIUM: index assignment through expression chains
let m = [[1, 2], [3, 4]];
m[1][0] = 9;
print(m[1][0]);           // 9
class Box { let items = [10, 20]; }
let b = new Box();
b.items[0] = 99;
print(b.items[0]);        // 99

// Improvement 2: shared array storage (reference semantics)
let a1 = [1, 2];
let a2 = a1;
push(a2, 3);
print(len(a1));           // 3

// Improvement 4: push/pop on object fields
push(b.items, 30);
print(len(b.items));      // 3
print(pop(b.items));      // 30

// Improvement 1: logical operators with short-circuit
print(!false);            // true
print(true && false);     // false
print(false || true);     // true
let r = false && (1 / 0 == 0);   // short-circuit: no div-by-zero
print(r);                 // false
let r2 = true || (1 / 0 == 0);
print(r2);                // true

// Improvement 5: ++/-- on fields and indexes
b.items[0]++;
print(b.items[0]);        // 100
let cnt = {"n": 5};
cnt["n"]++;
print(cnt["n"]);          // 6

// Improvement 6: string comparisons
print("abc" < "abd");     // true
print("b" >= "a");        // true

// Improvement 3: conversions + string builtins
print(int("17") + 1);     // 18
print(float("1.5") * 2);  // 3.0
print(str(42));           // 42
print(len(split("a,b,c", ",")));   // 3
print(substr("hello", 1, 3));      // ell
print(indexOf("hello", "ll"));     // 2
print(upper("abc"));               // ABC
print(lower("ABC"));               // abc
print(trim("  x  "));              // x
print(replace("aaa", "a", "b"));   // bbb
print(join([1, 2, 3], "-"));       // 1-2-3

// for-in over string and dict
let chars = "";
for (ch in "ab") { chars = chars + ch; }
print(chars);             // ab
let d = {"b": 2, "a": 1};
let keys = "";
for (k in d) { keys = keys + k; }
print(keys);              // ab (sorted)

// Improvement 10: numeric literals
print(0x10);              // 16
print(1e3);               // 1000.0
print(.5);                // 0.5
print(1.);                // 1.0

// Improvement 7: float wait
wait(0.5);
print("waited");          // waited
